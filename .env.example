APP_NAME="LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lms-lms-2-gecim.hostforgeplatforms.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mariadb
DB_HOST=<hostforge-database-host>
DB_PORT=3306
DB_DATABASE=<hostforge-database-name>
DB_USERNAME=<hostforge-database-user>
DB_PASSWORD=<hostforge-database-password>

# Academic Affairs (AA) — source of truth for enrollment/official records.
# Ginagamit ng Super Admin "Sync from AA" (admin panel → Sync from AA).
AA_DB_HOST=127.0.0.1
AA_DB_PORT=3306
AA_DB_DATABASE=aa_system
AA_DB_USERNAME=aa_readonly
AA_DB_PASSWORD=

# Built-in Virtual Classroom (LiveKit) — sarili ng LMS, hindi third-party links.
# Kunin ang credentials sa LiveKit Cloud (https://cloud.livekit.io) o sarili
# LiveKit server. LIVEKIT_URL hal. wss://your-project.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Walang SESSION_DOMAIN para gumana ang login sa kahit anong domain.
# Kapag custom domain na lang ang gamit, ilagay: SESSION_DOMAIN=.bcpsms2.com
SESSION_DOMAIN=
SESSION_SAME_SITE=lax
# Palitan ng false lang kung hindi gumana ang login sa HTTPS.
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=lms-lms-2-gecim.hostforgeplatforms.com,online-learning.bcpsms2.com

LMS_LOGIN_MAX_ATTEMPTS=5
LMS_LOGIN_LOCKOUT_MINUTES=15
LMS_SESSION_INACTIVITY_MINUTES=30

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_school@gmail.com
MAIL_PASSWORD=CHANGE_ME_16char_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="CHANGE_ME_school@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

LMS_LOGIN_OTP_ENABLED=true
LMS_LOGIN_OTP_EXPIRES_MINUTES=10
LMS_LOGIN_OTP_MAX_ATTEMPTS=5
LMS_LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60
LMS_LOGIN_OTP_SESSION_MINUTES=15
