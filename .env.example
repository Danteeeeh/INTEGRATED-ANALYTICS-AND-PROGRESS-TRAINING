APP_NAME="LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local development defaults only. In production, use the database host and
# credentials supplied by your hosting provider. 127.0.0.1 is this container,
# not a separate managed database service.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Login security
LMS_LOGIN_MAX_ATTEMPTS=5
LMS_LOGIN_LOCKOUT_MINUTES=15
LMS_SESSION_INACTIVITY_MINUTES=30

# Local development mailer. OTP messages are written to storage/logs/laravel.log.
# Change MAIL_MAILER to smtp only after setting a real Gmail App Password.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@lms.local"
MAIL_FROM_NAME="${APP_NAME}"

# Real Gmail SMTP (optional for actual OTP delivery):
# MAIL_MAILER=smtp
# MAIL_USERNAME=your.school@gmail.com
# MAIL_PASSWORD=your-16-char-google-app-password
# MAIL_FROM_ADDRESS="your.school@gmail.com"
# Gmail requires 2-Step Verification and an App Password, not your normal password.

# Email OTP verification for web login
LMS_LOGIN_OTP_ENABLED=true
LMS_LOGIN_OTP_EXPIRES_MINUTES=10
LMS_LOGIN_OTP_MAX_ATTEMPTS=5
LMS_LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60
LMS_LOGIN_OTP_SESSION_MINUTES=15
