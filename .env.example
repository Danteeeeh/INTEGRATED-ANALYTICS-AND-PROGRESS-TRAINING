APP_NAME="LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app-subdomain.hostforgeplatform.cloud

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Database ────────────────────────────────────────────────────────────
# IMPORTANT: DB_CONNECTION must be the plain connection NAME (a key from
# config/database.php), NOT a mysql:// DSN string. Use DB_HOST / DB_PORT /
# DB_DATABASE / DB_USERNAME / DB_PASSWORD separately.
#
# In HostForge, point these to the managed MariaDB/MySQL instance they
# provision for you. The values below are development placeholders only —
# replace EVERY value before deploy and NEVER commit real credentials.
DB_CONNECTION=mariadb
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=sync
CACHE_STORE=database

FILESYSTEM_DISK=local

# ── Sanctum / session-cookie origin whitelist ────────────────────────────
# Local development (kept for devs cloning the repo):
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:8000,localhost:8000
# Production — uncomment AND replace with your real HostForge domain(s):
# SANCTUM_STATEFUL_DOMAINS=hostforgeplatform.cloud,hostforgeplatforms.com,your-app-subdomain.hostforgeplatform.cloud,your-app-subdomain.hostforgeplatforms.com

# ── Login security (throttle + inactivity logout) ───────────────────────
LMS_LOGIN_MAX_ATTEMPTS=5
LMS_LOGIN_LOCKOUT_MINUTES=15
LMS_SESSION_INACTIVITY_MINUTES=30

# ── Mailer — real SMTP REQUIRED for Login OTP in production ─────────────
# Fill these with YOUR PROVIDER'S VALUES (Gmail App Password, Postmark,
# Sendgrid, Mailgun, SES, etc.). MAIL_MAILER=log does NOT deliver email.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Gmail SMTP example (requires 2-Step Verification enabled + an App Password):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your.school@gmail.com
# MAIL_PASSWORD=your-16-char-google-app-password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=your.school@gmail.com
# MAIL_FROM_NAME="${APP_NAME}"

# ── Email OTP verification for web login ────────────────────────────────
LMS_LOGIN_OTP_ENABLED=true
LMS_LOGIN_OTP_EXPIRES_MINUTES=10
LMS_LOGIN_OTP_MAX_ATTEMPTS=5
LMS_LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60
LMS_LOGIN_OTP_SESSION_MINUTES=15
