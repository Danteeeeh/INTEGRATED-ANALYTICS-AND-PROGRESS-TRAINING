APP_NAME="LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lms-lms-2-gecim.hostforgeplatforms.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mariadb
DB_HOST=<hostforge-database-host>
DB_PORT=3306
DB_DATABASE=<hostforge-database-name>
DB_USERNAME=<hostforge-database-user>
DB_PASSWORD=<hostforge-database-password>

# Academic Affairs (AA) — source of truth for enrollment/official records.
# Ginagamit ng Super Admin "Sync from AA" (admin panel → Sync from AA).
AA_DB_HOST=127.0.0.1
AA_DB_PORT=3306
AA_DB_DATABASE=aa_system
AA_DB_USERNAME=aa_readonly
AA_DB_PASSWORD=
AA_DB_CHARSET=utf8mb4
# AA_DB_SSL_CA=/path/to/aa-ca.pem

# Optional shared initial password for accounts the sync creates. Leave both
# blank to give every new student/faculty account its own random password.
# There is no built-in Welcome@123 fallback; users set their password through
# "Forgot your password?" on the login page.
AA_SYNC_DEFAULT_PASSWORD=
AA_SYNC_FACULTY_PASSWORD=

# Built-in Virtual Classroom (LiveKit) — sarili ng LMS, hindi third-party links.
# Kunin ang credentials sa LiveKit Cloud (https://cloud.livekit.io) o sarili
# LiveKit server. LIVEKIT_URL hal. wss://your-project.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Walang SESSION_DOMAIN para gumana ang login sa kahit anong domain.
# Kapag custom domain na lang ang gamit, ilagay: SESSION_DOMAIN=.bcpsms2.com
SESSION_DOMAIN=
SESSION_SAME_SITE=lax
# Palitan ng false lang kung hindi gumana ang login sa HTTPS.
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database

# Persistent uploads and backups. Leave blank for local development (uses
# storage/app). On HostForge set this to the mounted persistent volume, for
# example /data/lms. Without it, storage/app lives inside the release container
# and can be discarded on redeploy.
LMS_STORAGE_PATH=
FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=lms-lms-2-gecim.hostforgeplatforms.com,online-learning.bcpsms2.com

LMS_LOGIN_MAX_ATTEMPTS=5
LMS_LOGIN_LOCKOUT_MINUTES=15
LMS_SESSION_INACTIVITY_MINUTES=30

# Public self-registration. Keep false: student accounts come from Sync from
# AA, and an open /register form would let anyone create an active account.
LMS_REGISTRATION_ENABLED=false

# Demo logins (admin@/instructor@/student@/aa-staff@lms.local). They use a
# password published in this repository, so they are seeded only outside
# production. LMS_SEED_DEMO_USERS=true creates them anyway (demo/staging sites).
# LMS_SEED_DEMO_USERS=
# LMS_DEV_SEED_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_school@gmail.com
MAIL_PASSWORD=CHANGE_ME_16char_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="CHANGE_ME_school@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

LMS_LOGIN_OTP_ENABLED=true
LMS_LOGIN_OTP_EXPIRES_MINUTES=10
LMS_LOGIN_OTP_MAX_ATTEMPTS=5
LMS_LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60
LMS_LOGIN_OTP_SESSION_MINUTES=15
